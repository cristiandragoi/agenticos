{
  "name": "agenticos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:clean": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-clean.ps1",
    "dev:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-dev.ps1",
    "test": "vitest run src/",
    "prebuild:identity": "node scripts/build-identity.cjs",
    "build": "cd server && npm install && npm run build && cd .. && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:build": "npm run build && electron-builder",
    "package": "node scripts/package.cjs",
    "deploy:local": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$src='B:\\\\AgenticOS\\\\release\\\\win-unpacked'; $dst='C:\\\\Users\\\\Cris\\\\Desktop\\\\desktop\\\\Agentic_OS\\\\Agentic OS'; Write-Host 'Copying from' $src 'to' $dst; Copy-Item -Path \\\"$src\\\\*\\\" -Destination $dst -Recurse -Force; Write-Host 'Deploy complete. Run: Agentic OS.exe'\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@xyflow/react": "^12.11.1",
    "framer-motion": "^13.0.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.20.0",
    "puppeteer-screen-recorder": "^3.0.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.0",
    "react-virtuoso": "^4.18.11",
    "styled-components": "^6.4.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.4",
    "electron": "^34.1.0",
    "electron-builder": "^25.1.8",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.agenticos.app",
    "productName": "Agentic OS",
    "win": {
      "target": "dir",
      "icon": "build/icons/agenticos.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "shortcutName": "Agentic OS"
    },
    "directories": {
      "output": "release"
    },
    "asar": false,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "agentos-config.json"
    ],
    "extraResources": [
      { "from": "server/dist", "to": "server/dist" },
      { "from": "server/node_modules", "to": "server/node_modules" },
      { "from": "server/package.json", "to": "server/package.json" },
      { "from": "server/drizzle", "to": "server/drizzle" }
    ]
  }
}
