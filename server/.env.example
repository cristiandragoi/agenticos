PORT=4000
NODE_ENV=production

# Stripe Configuration
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email Delivery (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=deliveries@rekruitai.de

# Frontend URL (For Deliverable Links)
APP_BASE_URL=https://rekruitai.de

# Security (Run `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"` to generate)
JWT_SECRET=...

# AI Model
OPENAI_API_KEY=sk-proj-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=poolside/laguna-s-2.1:free
OPENROUTER_API_KEY=sk-or-v1-...

# Database (Supabase)
SUPABASE_URL=https://xyz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ey...
# Multi-Provider Gateway Config
OMNIROOT_BASE_URL=https://openrouter.ai/api/v1
OMNIROOT_API_KEY=
NINEROUTER_BASE_URL=https://api.nine.ai/v1
NINEROUTER_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_FALLBACK_MODEL=llama3.2:3b
GATEWAY_TIMEOUT_PRIMARY=30000
GATEWAY_TIMEOUT_FALLBACK=120000
GATEWAY_MAX_RETRIES=2
GATEWAY_PROVIDER_ORDER=omniroot,ninerouter,ollama
WEAK_HARDWARE=true
