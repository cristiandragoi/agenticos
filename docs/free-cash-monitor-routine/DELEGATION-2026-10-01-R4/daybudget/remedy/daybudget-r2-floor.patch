+def probe_reading(source_kind, day):
+    """Availability pre-flight for *day*, performed BEFORE the day is consumed.
+
+    Operator R2 ("check status once per day") is a cap *and* a floor: a run that
+    can acquire no reading must leave the day open so a later run that day can
+    still read.  The operator-entered source is a local file read -- no socket,
+    no credential, no request -- so probing it here is not the day's status read
+    and cannot race the day lock.
+
+    The metrics source is deliberately **not** probed: its read *is* the network
+    operation, so the day lock must stay ahead of it (the cap).  A metrics read
+    that turns out to hold no figures is handled after the lock by the fallback
+    in ``_run``.
+
+    Returns the probe result, or ``None`` when the source cannot be probed.
+    """
+    if source_kind == "operator_state":
+        return operator_state.read_source(day)
+    return None
+
+
+def announce_unspent_day(day, source, lock=None, released=None, now=None, sender=None) -> None:
+    """Audit and report a run that acquired no reading and therefore spent no day.
+
+    The append-only alert log is the routine's evidence record, and the day is
+    left otherwise untouched: no day lock (or the key is given back), no ledger
+    row, no snapshot, no approval item.
+
+    The R4 reminder pass still runs.  A reminder is time-based -- it exists so a
+    pending approval cannot rot unnoticed -- and it neither reads the status nor
+    consumes the day, so a day without a reading must not silence it.
+    """
+    key_state = "NOT_TAKEN" if lock is None else ("RELEASED" if released else "HELD_RELEASE_FAILED")
+    ledger = gate.load_ledger()
+    notify.alert(
+        "MONITOR_DEGRADED",
+        day,
+        "No reading for %s (%s). Day key %s: no snapshot written, no success booked, "
+        "last_success_day and consecutive_missed_days untouched. The day stays available "
+        "until a reading exists, and the watchdog reports it as missed. Nothing is "
+        "compared and nothing is notified." % (day, source.get("note"), key_state),
+        severity=notify.SEVERITY_INFO,
+        observed={
+            "account_status": None,
+            "earnings_total_cents": None,
+            "balance_cents": None,
+            "pending_cents": None,
+            "source": source.get("kind"),
+            "degraded": True,
+            "day_lock": key_state,
+        },
+    )
+    reminders = nag_pending(day, now, sender, 0)
+    if now is None:
+        changedetect.prune_old_artifacts(now)
+    print(
+        "RUN_NO_DATA %s outcome=MONITOR_DEGRADED source=%s(data_available=False) snapshot=NONE "
+        "day_lock=%s last_success_day=%s consecutive_missed_days=%s reminders=%d"
+        % (
+            day,
+            source.get("kind"),
+            key_state,
+            ledger.get("last_success_day"),
+            ledger.get("consecutive_missed_days"),
+            reminders,
+        )
+    )
+
+
+def report_timezone(day, ledger, now=None) -> bool:
+    """Emit the timezone-change / unresolvable-zone warnings.  Never blocks a run.
+
+    Called on the covered path *and* on the no-reading path: a timezone problem
+    must be visible even on a day the routine could not read.
